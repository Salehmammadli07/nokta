{
  "expo": {
    "name": "nokta-host",
    "slug": "nokta-host",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nokta.host"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.nokta.host"
    },
    "plugins": [
      "expo-file-system",
      "expo-sharing"
    ]
  }
}
